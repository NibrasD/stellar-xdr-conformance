{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NibrasD/stellar-xdr-conformance/corpus/schema/scenes.schema.json",
  "title": "Stellar XDR conformance replay scenes",
  "description": "Whole ledgers kept for replay, with the participants an indexer must record for one transaction, derived from the ledger meta.",
  "type": "object",
  "required": ["description", "scenes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "cap", "source", "protocol_observed", "transaction_meta_version", "expected_participants"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^SCENE(-[A-Z0-9]+)+-\\d{4}$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "cap": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^CAP-\\d{4}(-\\d{2})?$" } },
          "related_issues": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "source": {
            "type": "object",
            "required": ["kind", "network_passphrase", "ledger", "ledger_hash", "tx_hash", "ledger_close_meta"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["testnet", "mainnet", "local-core"] },
              "network_passphrase": { "type": "string" },
              "ledger": { "type": "integer", "minimum": 1 },
              "ledger_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "tx_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "setup_tx_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "ledger_close_meta": {
                "type": "object",
                "required": ["file", "byte_length", "sha256"],
                "additionalProperties": false,
                "properties": {
                  "file": { "type": "string", "pattern": "^captured/[A-Za-z0-9._/-]+\\.xdr$" },
                  "byte_length": { "type": "integer", "minimum": 4 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            }
          },
          "protocol_observed": { "type": "integer", "minimum": 1 },
          "transaction_meta_version": { "type": "integer", "minimum": 0, "maximum": 4 },
          "roles": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[GC][A-Z2-7]{55}$" } },
          "expected_participants": {
            "type": "object",
            "required": ["fee", "state", "all"],
            "additionalProperties": false,
            "properties": {
              "fee": { "type": "array", "items": { "type": "string", "pattern": "^[GC][A-Z2-7]{55}$" } },
              "state": { "type": "array", "items": { "type": "string", "pattern": "^[GC][A-Z2-7]{55}$" } },
              "all": { "type": "array", "items": { "type": "string", "pattern": "^[GC][A-Z2-7]{55}$" } }
            }
          }
        }
      }
    }
  }
}
